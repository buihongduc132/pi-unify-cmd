{
  "name": "pi-unify-cmd",
  "version": "0.2.1",
  "description": "Load slash commands from Claude Code, OpenCode, Codex, and Gemini CLI into pi — adapter pattern with configurable sources and formats",
  "author": "buihongduc132",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/buihongduc132/pi-unify-cmd.git"
  },
  "homepage": "https://github.com/buihongduc132/pi-unify-cmd#readme",
  "bugs": {
    "url": "https://github.com/buihongduc132/pi-unify-cmd/issues"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi",
    "pi-coding-agent",
    "commands",
    "slash-commands",
    "unify"
  ],
  "files": [
    "extensions/**/*.ts",
    "skills/**/*",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check": "npm run typecheck && npm run test:coverage",
    "smoke-test": "tsx scripts/smoke-test.ts",
    "prepublishOnly": "npm run check"
  },
  "pi": {
    "extensions": [
      "./extensions"
    ],
    "skills": [
      "./skills"
    ]
  },
  "peerDependencies": {
    "@mariozechner/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.9",
    "tsx": "^4.22.0",
    "typescript": "^5.8.0",
    "vitest": "^4.1.9"
  }
}
